import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

// StatefulWidget is used because the center message changes when a button is clicked.
class MyApp extends StatefulWidget {
  const MyApp({super.key});

  @override
  State<MyApp> createState() => _MyAppState();
}

class _MyAppState extends State<MyApp> {
  // This value is displayed in the center of the screen.
  String message = 'Welcome Home';

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        appBar: AppBar(
          title: const Text('Layouts'),
          backgroundColor: Colors.blue,

          // AppBar actions appear in a row at the top-right.
          actions: [
            TextButton(
              onPressed: () {
                setState(() {
                  message = 'Welcome Home';
                });
              },
              child: const Text('Home', style: TextStyle(color: Colors.white)),
            ),
            TextButton(
              onPressed: () {
                setState(() {
                  message = 'Menu List';
                });
              },
              child: const Text('Menu', style: TextStyle(color: Colors.white)),
            ),
            TextButton(
              onPressed: () {
                setState(() {
                  message = 'Contact Us';
                });
              },
              child: const Text('Contact Us', style: TextStyle(color: Colors.white)),
            ),
            TextButton(
              onPressed: () {
                setState(() {
                  message = 'Help';
                });
              },
              child: const Text('Help', style: TextStyle(color: Colors.white)),
            ),
          ],
        ),

        // Center displays the message selected from the menu.
        body: Center(
          child: Text(
            message,
            style: const TextStyle(fontSize: 30, fontWeight: FontWeight.bold),
          ),
        ),
      ),
    );
  }
}
