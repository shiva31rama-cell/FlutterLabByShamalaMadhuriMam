import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

// StatefulWidget is used because the message changes
// when the user clicks a menu button.
class MyApp extends StatefulWidget {
  @override
  State<MyApp> createState() => MyAppState();
}

class MyAppState extends State<MyApp> {
  // This text is shown in the center of the screen.
  String message = "Welcome Home";

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,

      home: Scaffold(
        appBar: AppBar(
          title: Text("Layouts"),
          backgroundColor: Colors.blue,

          // AppBar actions are automatically arranged
          // from left to right at the top-right.
          actions: [
            TextButton(
              onPressed: () {
                setState(() {
                  message = "Welcome Home";
                });
              },
              child: Text(
                "Home",
                style: TextStyle(color: Colors.white),
              ),
            ),

            TextButton(
              onPressed: () {
                setState(() {
                  message = "Menu List";
                });
              },
              child: Text(
                "Menu",
                style: TextStyle(color: Colors.white),
              ),
            ),

            TextButton(
              onPressed: () {
                setState(() {
                  message = "Contact Us";
                });
              },
              child: Text(
                "Contact Us",
                style: TextStyle(color: Colors.white),
              ),
            ),

            TextButton(
              onPressed: () {
                setState(() {
                  message = "Help";
                });
              },
              child: Text(
                "Help",
                style: TextStyle(color: Colors.white),
              ),
            ),
          ],
        ),

        // The current message is displayed at the center.
        body: Center(
          child: Text(
            message,
            style: TextStyle(
              fontSize: 30,
              fontWeight: FontWeight.bold,
            ),
          ),
        ),
      ),
    );
  }
}
