import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    // MediaQuery gives the current screen width.
    final double width = MediaQuery.of(context).size.width;
    final bool isMobile = width < 600;

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        appBar: AppBar(
          title: const Text('Responsive UI'),
          backgroundColor: Colors.blue,
        ),
        body: Container(
          width: double.infinity,
          height: double.infinity,
          decoration: const BoxDecoration(
            // NetworkImage loads a wallpaper from the internet.
            image: DecorationImage(
              image: NetworkImage('https://picsum.photos/800'),
              fit: BoxFit.cover,
            ),
          ),
          child: Center(
            child: isMobile
                ? Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      const Text(
                        'Mobile Screen',
                        style: TextStyle(fontSize: 25, color: Colors.white),
                      ),
                      const SizedBox(height: 20),
                      ElevatedButton(onPressed: () {}, child: const Text('Home')),
                      ElevatedButton(onPressed: () {}, child: const Text('Profile')),
                      ElevatedButton(onPressed: () {}, child: const Text('Settings')),
                    ],
                  )
                : Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      const Text(
                        'Desktop Screen',
                        style: TextStyle(fontSize: 25, color: Colors.white),
                      ),
                      const SizedBox(width: 25),
                      ElevatedButton(onPressed: () {}, child: const Text('Home')),
                      const SizedBox(width: 10),
                      ElevatedButton(onPressed: () {}, child: const Text('About')),
                      const SizedBox(width: 10),
                      ElevatedButton(onPressed: () {}, child: const Text('Contact')),
                    ],
                  ),
          ),
        ),
      ),
    );
  }
}
