// Reusable Custom Widget
class FoodCard extends StatelessWidget {
  IconData icon;
  String name;
  String price;

  FoodCard({
    required this.icon,
    required this.name,
    required this.price,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      elevation: 5,

      child: ListTile(

        // Food Icon
        leading: Icon(
          icon,
          size: 50,
          color: Colors.deepOrangeAccent,
        ),

        // Food Name
        title: Text(
          name,
          style: TextStyle(
            fontSize: 20,
            fontWeight: FontWeight.bold,
          ),
        ),

        // Food Price
        subtitle: Text(
          price,
          style: TextStyle(
            fontSize: 16,
            color: Colors.green,
          ),
        ),

        // Add to Cart Button
        trailing: ElevatedButton(
          onPressed: () {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text("$name added to cart"),
              ),
            );
          },
          child: Text("ADD TO CART"),
        ),
      ),
    );
  }
}
