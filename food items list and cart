import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: const FoodScreen(),
    );
  }
}

class FoodScreen extends StatelessWidget {
  const FoodScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Food Ordering App'),
        backgroundColor: Colors.orange,
      ),
      body: ListView(
        padding: const EdgeInsets.all(15),
        children: const [
          FoodCard(icon: Icons.local_pizza, name: 'Pizza', price: '₹250'),
          SizedBox(height: 15),
          FoodCard(icon: Icons.lunch_dining, name: 'Burger', price: '₹150'),
          SizedBox(height: 15),
          FoodCard(icon: Icons.rice_bowl, name: 'Biryani', price: '₹200'),
          SizedBox(height: 15),
          FoodCard(icon: Icons.eco, name: 'Healthy Salad', price: '₹120'),
          SizedBox(height: 15),
          FoodCard(icon: Icons.breakfast_dining, name: 'Idli', price: '₹80'),
          SizedBox(height: 15),
          FoodCard(icon: Icons.apple, name: 'Fruit Bowl', price: '₹100'),
          SizedBox(height: 15),
          FoodCard(icon: Icons.lunch_dining, name: 'Veg Sandwich', price: '₹130'),
        ],
      ),
    );
  }
}

// Reusable widget for displaying one food item.
class FoodCard extends StatelessWidget {
  final IconData icon;
  final String name;
  final String price;

  const FoodCard({
    super.key,
    required this.icon,
    required this.name,
    required this.price,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      elevation: 5,
      child: ListTile(
        leading: Icon(icon, size: 50, color: Colors.deepOrangeAccent),
        title: Text(
          name,
          style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
        ),
        subtitle: Text(
          price,
          style: const TextStyle(fontSize: 16, color: Colors.green),
        ),
        trailing: ElevatedButton(
          onPressed: () {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(content: Text('$name added to cart')),
            );
          },
          child: const Text('ADD TO CART'),
        ),
      ),
    );
  }
}
